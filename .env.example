# Copy to .env and fill in. Never commit .env.

# --- Postgres ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=inspections

# --- Backend ---
# Inside docker compose the ML service is reachable by its service name.
# When the ML service runs on AMD Developer Cloud, put that machine's URL here.
ML_SERVICE_URL=http://ml-service:8000
ML_TIMEOUT_MS=30000

# --- ML service ---
# 1 = return fake results that match the contract (no models needed)
ML_STUB=1
# OpenAI-compatible endpoint of the vLLM server on AMD Developer Cloud
LLM_BASE_URL=http://localhost:8001/v1
LLM_API_KEY=not-needed-for-vllm
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- Frontend ---
VITE_API_URL=http://localhost:3000/api
