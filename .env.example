# Copy to .env and fill in. Never commit .env.

# --- Postgres ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=inspections

# --- Ports on your machine (change one if it's already in use, e.g. POSTGRES_PORT=5433) ---
# Inside Docker the services always talk on the default ports; these only affect your laptop.
POSTGRES_PORT=5432
ML_PORT=8000
BACKEND_PORT=3000
FRONTEND_PORT=5173

# --- Backend ---
# Inside docker compose the ML service is reachable by its service name.
# When the ML service runs on AMD Developer Cloud, put that machine's URL here.
ML_SERVICE_URL=http://ml-service:8000
ML_TIMEOUT_MS=30000

# --- ML service ---
# 1 = return fake results that match the contract (no models needed)
ML_STUB=1
# OpenAI-compatible LLM endpoint: AMD Token Factory (notebooks.amd.com/tokenfactory)
LLM_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
LLM_API_KEY=
LLM_MODEL=Gemma-4-31B-IT

# --- Frontend ---
# If you change BACKEND_PORT, use the same port here.
VITE_API_URL=http://localhost:3000/api
